{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "needle-exposure-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": { "required": ["LINE_CHANNEL_SECRET", "LINE_CHANNEL_ACCESS_TOKEN", "HMAC_SECRET"] },
  // Local binding only. Add the real namespace ID before deployment (Ticket 8).
  "kv_namespaces": [{ "binding": "STATE_KV" }],
  // Disable automatic invocation logging to avoid retaining webhook metadata.
  "observability": { "enabled": false }
}
