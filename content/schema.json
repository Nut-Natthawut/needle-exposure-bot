{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source-backed clinical route",
  "type": "object",
  "additionalProperties": false,
  "required": ["routeId", "category", "presentation", "text", "source", "next"],
  "properties": {
    "routeId": { "$ref": "#/definitions/routeId" },
    "category": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "presentation": { "enum": ["text", "flex"] },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "enabled": { "type": "boolean" },
    "disabledReason": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "pages"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "pages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["routeId", "label"],
        "properties": {
          "routeId": { "$ref": "#/definitions/routeId" },
          "label": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    }
  },
  "definitions": {
    "routeId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" }
  }
}
